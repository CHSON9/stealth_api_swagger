{
  "definitions": {},
  "info": {
    "description": "powered by Flasgger",
    "termsOfService": "/tos",
    "title": "A swagger API",
    "version": "0.0.1"
  },
  "paths": {
    "/api/persons": {
      "get": {
        "description": "\uc0ac\uc804 \ub4f1\ub85d\ub41c \uc778\ubb3c 3\uba85(\ucc44\ud604, \uc740\uc544, \ud61c\ubbfc)\uc758 \uae30\ubcf8 \uc815\ubcf4 \ubc0f \ub300\ud45c \uc0ac\uc9c4 URL\uc744 \uc870\ud68c",
        "responses": {
          "200": {
            "description": "\uc778\ubb3c \ubaa9\ub85d \uc870\ud68c \uc131\uacf5",
            "schema": {
              "properties": {
                "persons": {
                  "items": {
                    "properties": {
                      "name": {
                        "example": "\ucc44\ud604",
                        "type": "string"
                      },
                      "person_id": {
                        "example": "person_01",
                        "type": "string"
                      },
                      "representative_image_url": {
                        "example": "/uploads/persons/chaehyeon_rep.jpg",
                        "type": "string"
                      }
                    }
                  },
                  "type": "array"
                },
                "status": {
                  "example": "success",
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "\uc11c\ubc84 \ub0b4\ubd80 \uc5d0\ub7ec"
          }
        },
        "summary": "\ub4f1\ub85d \uc778\ubb3c \ubaa9\ub85d \uc870\ud68c API",
        "tags": [
          "Persons"
        ]
      },
      "post": {
        "consumes": [
          "multipart/form-data"
        ],
        "description": "\uc0c8\ub85c\uc6b4 \uc778\ubb3c\uc758 \uc774\ub984\uacfc \uc0ac\uc9c4 \ud30c\uc77c\ub4e4(20~30\uc7a5)\uc744 multipart/form-data\ub85c \ubc1b\uc544 \uc11c\ubc84 \ubc0f DB\uc5d0 \uc2e0\uaddc \ub4f1\ub85d",
        "parameters": [
          {
            "description": "\ub4f1\ub85d\ud560 \uc778\ubb3c\uc758 \uc774\ub984 (\uc608; \ucc44\ud604)",
            "in": "formData",
            "name": "name",
            "required": true,
            "type": "string"
          },
          {
            "description": "\uc5c5\ub85c\ub4dc\ud560 \uc778\ubb3c \uc0ac\uc9c4 \ud30c\uc77c\ub4e4 (\ub2e4\uc911 \uc120\ud0dd \uac00\ub2a5)",
            "in": "formData",
            "name": "photos",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "201": {
            "description": "\uc778\ubb3c \ub4f1\ub85d \uc131\uacf5"
          },
          "400": {
            "description": "\ud544\uc218 \uc785\ub825\uac12 \ub610\ub294 \uc720\ud6a8\ud55c \ud30c\uc77c \ub204\ub77d"
          },
          "500": {
            "description": "\uc11c\ubc84 \ub0b4\ubd80 \uc5d0\ub7ec"
          }
        },
        "summary": "\uc778\ubb3c \uc2e0\uaddc \ub4f1\ub85d API",
        "tags": [
          "Persons"
        ]
      }
    },
    "/api/persons/{person_id}/photos": {
      "get": {
        "description": "\uc120\ud0dd\ud55c \uc778\ubb3c(person_id)\uc758 \ub4f1\ub85d\ub41c \uc804\uccb4 \uc0ac\uc9c4(20~30\uc7a5) \ubaa9\ub85d\uc744 \uc870\ud68c",
        "parameters": [
          {
            "description": "\uc870\ud68c\ud560 \uc778\ubb3c\uc758 \uace0\uc720 \uc2dd\ubcc4\uc790 (\uc608; person_01)",
            "in": "path",
            "name": "person_id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "\uc0ac\uc9c4 \ubaa9\ub85d \uc870\ud68c \uc131\uacf5",
            "schema": {
              "properties": {
                "name": {
                  "example": "\ucc44\ud604",
                  "type": "string"
                },
                "person_id": {
                  "example": "person_01",
                  "type": "string"
                },
                "photos": {
                  "items": {
                    "properties": {
                      "image_url": {
                        "example": "/uploads/persons/chaehyeon_01.jpg",
                        "type": "string"
                      },
                      "is_representative": {
                        "example": true,
                        "type": "boolean"
                      },
                      "photo_id": {
                        "example": "photo_01",
                        "type": "string"
                      }
                    }
                  },
                  "type": "array"
                },
                "status": {
                  "example": "success",
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "\ud574\ub2f9 \uc778\ubb3c\uc744 \ucc3e\uc744 \uc218 \uc5c6\uc74c"
          },
          "500": {
            "description": "\uc11c\ubc84 \ub0b4\ubd80 \uc5d0\ub7ec"
          }
        },
        "summary": "\uc778\ubb3c\ubcc4 \ub4f1\ub85d \uc0ac\uc9c4 \uc870\ud68c API",
        "tags": [
          "Persons"
        ]
      }
    },
    "/api/photos/{photo_id}/representative": {
      "patch": {
        "description": "\uc120\ud0dd\ud55c \uc0ac\uc9c4(photo_id)\uc744 \uc778\ubb3c\uc758 \uc0c8\ub85c\uc6b4 \ub300\ud45c \uc0ac\uc9c4\uc73c\ub85c \uc9c0\uc815",
        "parameters": [
          {
            "description": "\ub300\ud45c \uc0ac\uc9c4\uc73c\ub85c \uc9c0\uc815\ud560 \uc0ac\uc9c4\uc758 photo_id",
            "in": "path",
            "name": "photo_id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "\ub300\ud45c \uc0ac\uc9c4 \ubcc0\uacbd \uc131\uacf5"
          },
          "404": {
            "description": "\ud574\ub2f9 \uc0ac\uc9c4\uc744 \ucc3e\uc744 \uc218 \uc5c6\uc74c"
          },
          "500": {
            "description": "\uc11c\ubc84 \ub0b4\ubd80 \uc5d0\ub7ec"
          }
        },
        "summary": "\ub300\ud45c \uc0ac\uc9c4 \ubcc0\uacbd API",
        "tags": [
          "Photos"
        ]
      }
    },
    "/socket_docs": {
      "get": {
        "description": "\uc774 \uc139\uc158\uc740 2\ud559\uae30 \uc774\ub3d9\ud615 \uce74\uba54\ub77c \ud22c\uba85\ud654 \ube44\uc804 \uc2dc\uc2a4\ud15c\uc758 Socket.io \uc774\ubca4\ud2b8\ub97c \uc815\uc758\n\n### [1] \ud074\ub77c\uc774\uc5b8\ud2b8 -> \uc11c\ubc84 (Client -> Server Events)\n\n1. **`register_client`**\n   - **\uc124\uba85**: \ud504\ub860\ud2b8 \uc811\uc18d \uc2dc \uae30\uae30 \uc5ed\ud560(\ud578\ub4dc\ud3f0/\ub178\ud2b8\ubd81)\uc744 \ub4f1\ub85d\n   - **\ub370\uc774\ud130 \uaddc\uaca9**:\n     ```json\n     {\n       \"role\": \"sender\" // \ud578\ub4dc\ud3f0(\uc1a1\ucd9c\uc790)\uc77c \uacbd\uc6b0 \"sender\", \ub178\ud2b8\ubd81(\uc2dc\uccad\uc790)\uc77c \uacbd\uc6b0 \"viewer\"\n     }\n     ```\n   \n2. **`image_frame`**\n   - **\uc124\uba85**: \ud578\ub4dc\ud3f0 \uce74\uba54\ub77c \uc6f9\ubdf0\uc5d0\uc11c \uc6d0\ubcf8 \uc774\ubbf8\uc9c0 \ud504\ub808\uc784\uc744 \ucd08\ub2f9 \uc1a1\ucd9c\n   - **\ub370\uc774\ud130 \uaddc\uaca9**:\n     ```json\n     {\n       \"image\": \"data:image/jpeg;base64,.....(Base64 \ubb38\uc790\uc5f4)\",\n       \"camera_id\": \"cam1\"\n     }\n     ```\n     \n---\n\n### [2] \uc11c\ubc84 -> \ud074\ub77c\uc774\uc5b8\ud2b8 (Server -> Client Events)\n\n1. **`processed_frame`**\n   - **\uc124\uba85**: AI \ud30c\uc774\ud504\ub77c\uc778\uc5d0\uc11c \ud22c\uba85\ud654/\ubc30\uacbd\ubcf5\uc6d0\uc774 \uc644\ub8cc\ub41c \ucc98\ub9ac \uc601\uc0c1 \ud504\ub808\uc784\uc744 \ub178\ud2b8\ubd81(`viewer`)\uc73c\ub85c \uc804\uc1a1\n   - **\ub370\uc774\ud130 \uaddc\uaca9**:\n     ```json\n     {\n       \"result_image\": \"data:image/jpeg;base64,.....(Base64 \ubb38\uc790\uc5f4)\"\n     }\n     ```\n   \n2. **`stream_status`**\n   - **\uc124\uba85**: \ud604\uc7ac \uc601\uc0c1 \ucc98\ub9ac \ubc0f \uc1a1\ucd9c \uc0c1\ud0dc\ub97c \uc54c\ub824\uc90c\n   - **\ub370\uc774\ud130 \uaddc\uaca9**:\n     ```json\n     {\n       \"status\": \"streaming\" // waiting, processing, streaming, stopped\n     }\n     ```\n   \n3. **`stream_error`**\n   - **\uc124\uba85**: \uc601\uc0c1 \uac00\uacf5 \ubc0f \ud504\ub808\uc784 \ucc98\ub9ac \uacfc\uc815\uc5d0\uc11c \uc608\uc678/\uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc744 \ub54c \uc804\ub2ec\n   - **\ub370\uc774\ud130 \uaddc\uaca9**:\n     ```json\n     {\n       \"code\": \"PROCESSING_FAILED\",\n       \"message\": \"AI \ud504\ub808\uc784 \uac00\uacf5 \uc2e4\ud328.\"\n     }\n     ```",
        "summary": "\uc2e4\uc2dc\uac04 \ud1b5\uc2e0 (Socket.io) \uba85\uc138\uc11c",
        "tags": [
          "Real-time (Socket.io)"
        ]
      }
    }
  },
  "swagger": "2.0"
}
