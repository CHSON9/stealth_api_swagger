{
  "swagger": "2.0",
  "info": {
    "title": "2학기 스텔스 비전 프로젝트 API 명세서",
    "description": "프론트엔드 연동용 REST API 및 Socket.io 명세서",
    "version": "1.0.0"
  },
  "host": "localhost:5000",
  "basePath": "/",
  "schemes": ["http"],
  "paths": {
    "/api/persons": {
      "get": {
        "tags": ["Persons"],
        "summary": "등록 인물 목록 조회",
        "description": "사전 등록된 인물 3명(채현, 은아, 혜민)의 기본 정보 및 대표 사진 URL을 조회합니다.",
        "responses": {
          "200": {
            "description": "조회 성공",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "success" },
                "persons": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "person_id": { "type": "string", "example": "person_01" },
                      "name": { "type": "string", "example": "채현" },
                      "representative_image_url": { "type": "string", "example": "/uploads/persons/chaehyeon_rep.jpg" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/persons/{person_id}/photos": {
      "get": {
        "tags": ["Persons"],
        "summary": "인물별 등록 사진 조회",
        "description": "선택한 인물의 전체 사진(20~30장) 목록을 조회합니다.",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "인물 고유 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "success" },
                "person_id": { "type": "string", "example": "person_01" },
                "name": { "type": "string", "example": "채현" },
                "photos": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "photo_id": { "type": "string", "example": "photo_01" },
                      "image_url": { "type": "string", "example": "/uploads/persons/chaehyeon_01.jpg" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}